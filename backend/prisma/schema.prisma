// ─── Payroll (Fees & Finance) ─────────────────────────────────────────────────

enum PayrollEmploymentType {
  TEACHING
  NON_TEACHING
  ADMIN
  SUPPORT
}

enum PayrollSlipStatus {
  DRAFT
  GENERATED
  PAID
  CANCELLED
}

/// Staff / employee master for payroll processing
model PayrollEmployee {
  id              String                @id @default(cuid())
  institutionId   String
  institution     Institution           @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  employeeCode    String
  fullName        String
  employmentType  PayrollEmploymentType @default(TEACHING)
  department      String                @default("General")
  designation     String                @default("Staff")
  mobile          String                @default("")
  email           String                @default("")
  joinDate        DateTime?
  bankAccount     String                @default("")
  bankIfsc        String                @default("")
  panNumber       String                @default("")
  uanNumber       String                @default("")
  pfNumber        String                @default("")
  esicNumber      String                @default("")
  epfApplicable   Boolean               @default(true)
  esicApplicable  Boolean               @default(true)
  status          FeeMasterStatus       @default(ACTIVE)
  remarks         String                @default("")
  classGroup      String                @default("")
  profileData     Json                  @default("{}")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  salaryStructures PayrollSalaryStructure[]
  slips            PayrollSlip[]
  attendanceRecords HrAttendanceDailyRecord[]
  attendanceCorrections HrAttendanceCorrection[]
  leaveApplications HrLeaveApplication[]
  leaveBalances HrLeaveBalance[]
  leavePolicyAssignments HrLeavePolicyAssignment[]
  salaryStructureAssignments HrSalaryStructureAssignment[]
  shiftAssignments HrEmployeeShiftAssignment[]
  shiftChangeRequests HrShiftChangeRequest[]
  shiftSubstitutesAbsent HrShiftSubstitute[] @relation("AbsentEmployee")
  shiftSubstitutesCover HrShiftSubstitute[] @relation("SubstituteEmployee")
  shiftOvertimeRecords HrShiftOvertimeRecord[]
  shiftDutyAssignments HrShiftDutyAssignment[]
  performanceAppraisals HrPerformanceAppraisal[]
  performanceAnnualReviews HrPerformanceAnnualReview[]
  performancePips HrPerformancePip[]
  developmentPlans HrEmployeeDevelopmentPlan[]
  trainingNominations HrTrainingNomination[]
  trainingAttendances HrTrainingAttendance[]
  trainingCertificates HrTrainingCertificate[]
  trainingIdps HrTrainingIdp[]
  edomsOnboardings HrEdomsOnboarding[]
  exitResignations HrExitResignation[]

  @@unique([institutionId, employeeCode])
  @@index([institutionId, status])
  @@index([institutionId, employmentType])
  @@index([institutionId, department])
}

/// HR department master with org structure & settings
model HrDepartment {
  id                  String        @id @default(cuid())
  institutionId       String
  institution         Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  code                String
  name                String
  parentId            String?
  parent              HrDepartment? @relation("HrDeptHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children            HrDepartment[] @relation("HrDeptHierarchy")
  headEmployeeId      String        @default("")
  reportsToEmployeeId String        @default("")
  shortDescription    String        @default("")
  detailedDescription String        @default("")
  campus              String        @default("Main Campus")
  status              String        @default("ACTIVE")
  budgetAllocation    Float         @default(0)
  costCenter          String        @default("")
  email               String        @default("")
  phone               String        @default("")
  workingDays         Json          @default("[]")
  logoUrl             String        @default("")
  notes               String        @default("")
  functions           Json          @default("[]")
  structureTree       Json          @default("[]")
  settings            Json          @default("{}")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@unique([institutionId, code])
  @@index([institutionId, parentId])
  @@index([institutionId, status])
}

