  action        String
  changedBy     String            @default("system")
  snapshot      Json              @default("{}")
  remarks       String            @default("")
  createdAt     DateTime          @default(now())

  @@index([componentId, createdAt])
}

/// Salary structure (earnings + statutory / other deductions) per employee
