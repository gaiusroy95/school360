  incrementPercent Float           @default(0)
  recommendedPayGrade String        @default("")
  workflowStage    String          @default("EMPLOYEE")
  status           String          @default("DRAFT")
  salaryRevisionStatus String      @default("PENDING")
  remarks          String          @default("")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([employeeId, academicYear])
  @@index([institutionId, academicYear])
}

