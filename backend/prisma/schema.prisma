enum MobileAppRole {
  STUDENT
  PARENT
  TEACHER
  PRINCIPAL
  TRANSPORT
}

enum MobileDevicePlatform {
  IOS
  ANDROID
  WEB
  OTHER
}

/// Login identity for mobile apps — separate from dashboard User accounts.
model MobileAccount {
  id                String        @id @default(cuid())
  institutionId     String
  institution       Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  role              MobileAppRole
  admissionNumber   String        @default("")
  employeeCode      String        @default("")
  registeredMobile  String
  passwordHash      String
  mustResetPassword Boolean       @default(true)
  displayName       String
  studentId         String?
  parentKey         String        @default("")
  parentRelationship ParentRelationship?
  teacherProfileId  String?
  staffProfileId    String?
  studentIds        Json          @default("[]")
  isActive          Boolean       @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  devices           MobileDevice[]
  notifications     MobileNotification[]
  uploads           MobileUpload[]
  reminderPreference MobileReminderPreference?

  @@unique([institutionId, role, admissionNumber, registeredMobile])
  @@unique([institutionId, role, employeeCode, registeredMobile])
  @@index([institutionId, studentId])
  @@index([institutionId, parentKey])
  @@index([institutionId, role, isActive])
}

