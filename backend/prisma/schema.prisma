  registeredMobile String
  otpHash          String
  expiresAt        DateTime
  attempts         Int       @default(0)
  consumedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([institutionId, registeredMobile, identifier, createdAt])
}

