{
  "expo": {
    "name": "360schoolERP Family",
    "slug": "360schoolerp-student-parent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/favicon.png",
    "scheme": "schoolerp-family",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.schoolerp.family"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/favicon.png",
        "backgroundColor": "#2563eb"
      },
      "package": "com.schoolerp.family"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#2563eb"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "902486a3-5f62-4ece-9dac-7da3d9523ca4"
      }
    }
  }
}
