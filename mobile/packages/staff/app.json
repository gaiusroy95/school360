{
  "expo": {
    "name": "360schoolERP Staff",
    "slug": "360schoolerp-staff",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/favicon.png",
    "scheme": "schoolerp-staff",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.schoolerp.staff"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/favicon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.schoolerp.staff",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#7c3aed"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Track school transport vehicles during duty hours."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "80319b92-0009-44c2-89b7-5abf7b07ded1"
      }
    },
    "owner": "kok-expo"
  }
}
